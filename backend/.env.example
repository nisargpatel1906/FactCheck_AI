# ==============================
# FactCheck AI — Environment Variables
# ==============================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit the .env file to version control.

# --- API Keys (numbered rotation pool — up to 8 per provider) ---
# On any API error the system instantly rotates to the next key.
# Add as many as you have (1–8). At least NVIDIA_API_KEY_1 and GROQ_API_KEY_1 are required.
#
# Single-key fallback (for local dev with one key): set NVIDIA_API_KEY, TAVILY_API_KEY, GROQ_API_KEY
# instead of the numbered variants. Both styles are supported.

# NVIDIA NIM — https://build.nvidia.com
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
NVIDIA_API_KEY_6=
NVIDIA_API_KEY_7=
NVIDIA_API_KEY_8=

# Tavily Search — https://tavily.com  (optional — leaves blank to use DuckDuckGo fallback)
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
TAVILY_API_KEY_3=
TAVILY_API_KEY_4=
TAVILY_API_KEY_5=
TAVILY_API_KEY_6=
TAVILY_API_KEY_7=
TAVILY_API_KEY_8=

# Groq (Whisper STT) — https://console.groq.com
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=

# --- Database ---
# Leave DATABASE_URL blank to use local SQLite (development).
# Set DATABASE_URL to a PostgreSQL connection string for production (Railway).
DATABASE_URL=DATABASE_URL

DATABASE_PATH=./factcheck.db

# --- NVIDIA NIM Model IDs (confirm current IDs at build.nvidia.com) ---
MODEL_CLAIM_DETECTION=meta/llama-3.1-8b-instruct
MODEL_RESEARCH=meta/llama-3.1-8b-instruct
MODEL_JUDGE=meta/llama-3.1-8b-instruct
MODEL_EMBEDDING=nvidia/nv-embedqa-e5-v5
MODEL_STT=openai/whisper-large-v3

# --- Tunable Parameters ---
SIMILARITY_THRESHOLD=0.85
CLAIM_DETECTION_WINDOW_SECONDS=20
NUM_PIPELINE_WORKERS=2
