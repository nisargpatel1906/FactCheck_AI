# ==============================
# FactCheck AI — Environment Variables
# ==============================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# --- Required (no defaults) ---
NVIDIA_API_KEY=               # Your personal NVIDIA NIM API key from build.nvidia.com
TAVILY_API_KEY=                # Required only if using Tavily for web search (leave blank to use DuckDuckGo)

# --- Database ---
DATABASE_PATH=./factcheck.db

# --- NVIDIA NIM Model IDs (confirm current IDs at build.nvidia.com) ---
# MODEL_CLAIM_DETECTION=nvidia/llama-3.1-nemotron-nano-8b-v1
# MODEL_RESEARCH=nvidia/llama-3.1-nemotron-super-49b-v1
# MODEL_JUDGE=nvidia/llama-3.1-nemotron-ultra-253b-v1
# MODEL_EMBEDDING=nvidia/nv-embedqa-e5-v5
# MODEL_STT=nvidia/parakeet-ctc-1.1b-asr

# --- Tunable Parameters (starting points — adjust during testing) ---
SIMILARITY_THRESHOLD=0.85
CLAIM_DETECTION_WINDOW_SECONDS=20
NUM_PIPELINE_WORKERS=2
