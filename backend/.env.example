# ==============================
# FactCheck AI — Environment Variables
# ==============================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit the .env file to version control.

# --- Required ---
NVIDIA_API_KEY=               # Get yours free at https://build.nvidia.com
TAVILY_API_KEY=               # Optional — leave blank to use DuckDuckGo fallback
GROQ_API_KEY=                 # Required for tab audio STT. Free at https://console.groq.com

# --- Database ---
DATABASE_PATH=./factcheck.db

# --- NVIDIA NIM Model IDs ---
# These MUST match valid model IDs from https://build.nvidia.com
# The defaults below are the production config. Smaller free-tier alternatives are listed as comments.
MODEL_CLAIM_DETECTION=nvidia/llama-3.1-nemotron-nano-8b-v1
# Free-tier alternative: meta/llama-3.1-8b-instruct
MODEL_RESEARCH=nvidia/llama-3.1-nemotron-super-49b-v1
# Free-tier alternative: meta/llama-3.1-8b-instruct
MODEL_JUDGE=nvidia/llama-3.1-nemotron-ultra-253b-v1
# Free-tier alternative: meta/llama-3.1-70b-instruct
MODEL_EMBEDDING=nvidia/nv-embedqa-e5-v5

# --- Tunable Parameters ---
SIMILARITY_THRESHOLD=0.85
CLAIM_DETECTION_WINDOW_SECONDS=20
NUM_PIPELINE_WORKERS=2
