# ==============================
# FactCheck AI — Environment Variables
# ==============================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit the .env file to version control.

# --- Required ---
NVIDIA_API_KEY=               # Get yours free at https://build.nvidia.com
TAVILY_API_KEY=               # Optional — leave blank to use DuckDuckGo fallback
GROQ_API_KEY=                 # Required for tab audio STT. Free at https://console.groq.com

# --- Database ---
DATABASE_PATH=./factcheck.db

# --- NVIDIA NIM Model IDs (confirm current IDs at build.nvidia.com) ---
MODEL_CLAIM_DETECTION=meta/llama-3.1-8b-instruct
# Use a larger model for the final verdict
MODEL_RESEARCH=meta/llama-3.1-8b-instruct
MODEL_JUDGE=meta/llama-3.1-8b-instruct
MODEL_EMBEDDING=nvidia/nv-embedqa-e5-v5
MODEL_STT=openai/whisper-large-v3

# --- Tunable Parameters (starting points — adjust during testing) ---
SIMILARITY_THRESHOLD=0.85
CLAIM_DETECTION_WINDOW_SECONDS=20
NUM_PIPELINE_WORKERS=2
